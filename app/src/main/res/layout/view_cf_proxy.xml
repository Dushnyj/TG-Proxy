<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/cf_proxy"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_cf_proxy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:buttonTint="@color/accent"
            android:includeFontPadding="false"
            android:text="@string/enable_cf_proxy"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_test_cf"
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_start_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/test"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_cf_custom_domain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:buttonTint="@color/accent"
            android:includeFontPadding="false"
            android:text="@string/cf_custom_domain"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_cf_help"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_start_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="?"
            android:textColor="@color/button_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_cf_domains"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/edit_bg"
        android:enabled="false"
        android:hint="@string/cf_domains"
        android:inputType="textUri"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/worker_domains"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_worker_help"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_start_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="?"
            android:textColor="@color/button_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_worker_domains"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/edit_bg"
            android:inputType="textUri"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_test_worker"
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_start_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/test"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
