<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/vps_relay"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/vps_relay_note"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:includeFontPadding="false"
        android:text="@string/vps_relay_saved"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/sp_vps_relay_saved"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/edit_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <CheckBox
        android:id="@+id/cb_vps_relay_enabled"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:buttonTint="@color/accent"
        android:includeFontPadding="false"
        android:text="@string/vps_relay_enabled"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_vps_relay_auto_setup"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:minHeight="52dp"
        android:text="@string/vps_relay_auto_setup"
        android:textAllCaps="false"
        android:textColor="@color/button_text"
        android:textSize="14sp"
        app:backgroundTint="@color/accent"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_server"
        app:iconGravity="textStart"
        app:iconTint="@color/button_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_vps_owner_manage"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:minHeight="52dp"
        android:text="@string/vps_owner_manage"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_shield"
        app:iconGravity="textStart"
        app:iconTint="@color/accent"
        app:strokeColor="@color/accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_vps_relay_test"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/test"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_refresh"
        app:iconGravity="textStart"
        app:iconTint="@color/accent"
        app:strokeColor="@color/divider" />

    <ProgressBar
        android:id="@+id/progress_vps_setup"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent" />

    <TextView
        android:id="@+id/tv_vps_setup_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/vps_setup_idle"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_vps_relay_new"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/vps_relay_new"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/accent"
            app:strokeColor="@color/divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_vps_relay_save"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1.35"
            android:minWidth="0dp"
            android:text="@string/vps_relay_save"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="13sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_vps_relay_delete"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:minHeight="44dp"
        android:text="@string/vps_relay_delete"
        android:textAllCaps="false"
        android:textColor="@color/red"
        android:textSize="12sp"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textStart"
        app:iconTint="@color/red" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_vps_manual_toggle"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/vps_manual_show"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/divider" />

    <LinearLayout
        android:id="@+id/vps_manual_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:text="@string/vps_relay_name"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/et_vps_relay_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edit_bg"
            android:hint="@string/vps_relay"
            android:inputType="textCapWords"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/vps_relay_host"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_vps_relay_host"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/edit_bg"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="94dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/vps_relay_port"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_vps_relay_port"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/edit_bg"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_vps_relay_tls"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:buttonTint="@color/accent"
            android:includeFontPadding="false"
            android:text="@string/vps_relay_tls"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cb_vps_relay_bind_profile"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:buttonTint="@color/accent"
            android:includeFontPadding="false"
            android:text="@string/vps_relay_bind_profile"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:text="@string/vps_relay_path"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/et_vps_relay_path"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edit_bg"
            android:hint="/apiws"
            android:inputType="textUri"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:text="@string/vps_relay_token"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/et_vps_relay_token"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edit_bg"
            android:fontFamily="monospace"
            android:inputType="textPassword|textNoSuggestions"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
