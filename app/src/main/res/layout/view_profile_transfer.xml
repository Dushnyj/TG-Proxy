<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/profile_transfer_title"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:text="@string/profile_transfer_note"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_export_safe_profile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/export_safe_profile"
            android:textAllCaps="false"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_export_encrypted_profile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_start_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/export_encrypted_profile"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_import_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/profile_transfer_import"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_scan_qr"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/scan_profile_qr"
        android:textAllCaps="false"
        android:textSize="13sp" />
</LinearLayout>
